DROP DATABASE IF EXISTS ai_partial_tz_red;
CREATE DATABASE ai_partial_tz_red;
USE ai_partial_tz_red;
CREATE TABLE t(
  id INT PRIMARY KEY,
  k INT,
  ts TIMESTAMP,
  UNIQUE INDEX uk(k) WHERE ts >= '2025-01-01 00:00:00'
);

-- UTC instant 2024-12-31 20:00:00, rendered in a -08:00 session.
SET time_zone='-08:00';
INSERT INTO t VALUES (1,7,'2024-12-31 12:00:00');

-- The same UTC instant, rendered in a +08:00 session.
SET time_zone='+08:00';
INSERT INTO t VALUES (2,7,'2025-01-01 04:00:00');

SELECT 'oracle' src,id,k,ts
FROM t IGNORE INDEX(uk)
WHERE ts >= '2025-01-01 00:00:00' AND k=7
ORDER BY id;

src     id  k  ts
oracle  1   7  2025-01-01 04:00:00
oracle  2   7  2025-01-01 04:00:00

SELECT 'index' src,id,k,ts
FROM t USE INDEX(uk)
WHERE ts >= '2025-01-01 00:00:00' AND k=7
ORDER BY id;

src    id  k  ts
index  2   7  2025-01-01 04:00:00

