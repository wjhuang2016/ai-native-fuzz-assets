+func (s *testSafePointSuite) TestExpiredTxnCannotResurrectDeletedKey() {
+	key := encodeKey(s.prefix, "expired-resurrection")
+
+	seed := s.beginTxn()
+	s.Require().NoError(seed.Set(key, []byte("original")))
+	s.Require().NoError(seed.Commit(context.Background()))
+
+	stale := s.beginTxn()
+	value, err := stale.Get(context.Background(), key)
+	s.Require().NoError(err)
+	s.Require().Equal([]byte("original"), value.Value)
+
+	deleter := s.beginTxn()
+	s.Require().NoError(deleter.Delete(key))
+	s.Require().NoError(deleter.Commit(context.Background()))
+	safePoint := deleter.CommitTS()
+
+	s.gcRegion(key, safePoint)
+	s.store.UpdateTxnSafePointCache(safePoint, time.Now())
+
+	s.Require().NoError(stale.Set(key, []byte("resurrected")))
+	commitErr := stale.Commit(context.Background())
+	s.Error(commitErr, "a transaction older than the txn safe point must not commit")
+
+	fresh := s.beginTxn()
+	value, err = fresh.Get(context.Background(), key)
+	s.Equal(error.ErrNotExist, errors.Cause(err))
+	s.Nil(value.Value)
+}
