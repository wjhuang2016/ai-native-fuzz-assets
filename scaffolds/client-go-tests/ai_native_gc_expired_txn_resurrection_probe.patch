+func (s *testSafePointSuite) gcRegion(key []byte, safePoint uint64) {
+	if *withTiKV {
+		newSafePoint, err := s.store.GC(context.Background(), safePoint)
+		s.Require().NoError(err)
+		s.Require().GreaterOrEqual(newSafePoint, safePoint)
+		time.Sleep(12 * time.Second)
+
+		bo := tikv.NewBackofferWithVars(context.Background(), 500, nil)
+		loc, err := s.store.GetRegionCache().LocateKey(bo, key)
+		s.Require().NoError(err)
+		rpcCtx, err := s.store.GetRegionCache().GetTiKVRPCContext(bo, loc.Region, kv.ReplicaReadLeader, 0)
+		s.Require().NoError(err)
+		s.Require().NotNil(rpcCtx)
+
+		ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+		defer cancel()
+		conn, err := grpc.DialContext(ctx, rpcCtx.Addr, grpc.WithTransportCredentials(insecure.NewCredentials()))
+		s.Require().NoError(err)
+		defer conn.Close()
+		debugClient := debugpb.NewDebugClient(conn)
+		for _, cf := range []string{"write", "default"} {
+			_, err = debugClient.Compact(ctx, &debugpb.CompactRequest{
+				Db:                        debugpb.DB_KV,
+				Cf:                        cf,
+				Threads:                   1,
+				BottommostLevelCompaction: debugpb.BottommostLevelCompaction_Force,
+			})
+			s.Require().NoError(err)
+		}
+		return
+	}
+
+	bo := tikv.NewBackofferWithVars(context.Background(), 500, nil)
+	loc, err := s.store.GetRegionCache().LocateKey(bo, key)
+	s.Require().NoError(err)
+	req := tikvrpc.NewRequest(tikvrpc.CmdGC, &kvrpcpb.GCRequest{SafePoint: safePoint})
+	resp, err := s.store.SendReq(bo, req, loc.Region, 10*time.Second)
+	s.Require().NoError(err)
+	s.Require().NotNil(resp.Resp)
+	s.Require().Nil(resp.Resp.(*kvrpcpb.GCResponse).GetError())
+}
