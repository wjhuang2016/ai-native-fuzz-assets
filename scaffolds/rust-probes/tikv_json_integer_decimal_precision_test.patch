+    fn test_json_integer_to_decimal_preserves_precision() {
+        let mut ctx = EvalContext::default();
+        for value in ["9007199254740993", "9223372036854775807", "18446744073709551615"] {
+            let json: Json = value.parse().unwrap();
+            let actual: Decimal = json.convert(&mut ctx).unwrap();
+            let expected = Decimal::from_bytes(value.as_bytes()).unwrap().unwrap();
+            assert_eq!(actual, expected, "JSON integer {value}");
+        }
+    }
