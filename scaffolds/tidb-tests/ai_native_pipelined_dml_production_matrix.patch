+func TestAINativePipelinedDMLLateNaturalConflictAtomicity(t *testing.T) {
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBMinFlushKeys", `return(10)`))
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBMinFlushSize", `return(100)`))
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBForceFlushSizeThreshold", `return(10240)`))
+	defer func() {
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBMinFlushKeys"))
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBMinFlushSize"))
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBForceFlushSizeThreshold"))
+	}()
+
+	store := realtikvtest.CreateMockStoreAndSetup(t)
+	bulk := testkit.NewTestKit(t, store)
+	competitor := testkit.NewTestKit(t, store)
+	fresh := testkit.NewTestKit(t, store)
+	for _, tk := range []*testkit.TestKit{bulk, competitor, fresh} {
+		tk.MustExec("use test")
+	}
+	bulk.MustQuery("select @@tidb_enable_metadata_lock").Check(testkit.Rows("1"))
+	bulk.MustExec("drop table if exists ai_conflict_src, ai_conflict_dst")
+	bulk.MustExec("create table ai_conflict_src(id int primary key, u int, pad varchar(128))")
+	bulk.MustExec("create table ai_conflict_dst(id int primary key, u int, pad varchar(128), unique key uk_u(u))")
+
+	values := bytes.NewBuffer(make([]byte, 0, 262144))
+	values.WriteString("insert into ai_conflict_src values ")
+	for i := range 2000 {
+		if i > 0 {
+			values.WriteString(",")
+		}
+		_, _ = fmt.Fprintf(values, "(%d,%d,'%s')", i, i, strings.Repeat("x", 96))
+	}
+	bulk.MustExec(values.String())
+	bulk.MustExec("set session tidb_dml_type = bulk")
+
+	// Let generation 1 prewrite normally, then hold generation 2 while an
+	// ordinary online transaction commits a key from the unflushed suffix.
+	require.NoError(t, failpoint.Enable("tikvclient/beforePipelinedFlush", `1*off->pause`))
+	defer func() { _ = failpoint.Disable("tikvclient/beforePipelinedFlush") }()
+	errCh := make(chan error, 1)
+	go func() {
+		errCh <- bulk.ExecToErr("insert into ai_conflict_dst select * from ai_conflict_src order by id")
+	}()
+	time.Sleep(500 * time.Millisecond)
+	competitor.MustExec("insert into ai_conflict_dst values (1500, 999999, 'online-winner')")
+	require.NoError(t, failpoint.Disable("tikvclient/beforePipelinedFlush"))
+
+	select {
+	case err := <-errCh:
+		require.Error(t, err)
+		require.True(t,
+			kv.ErrWriteConflict.Equal(err) || strings.Contains(err.Error(), "Duplicate entry") || strings.Contains(err.Error(), "assertion failed"),
+			"unexpected late-conflict error: %v", err)
+	case <-time.After(30 * time.Second):
+		t.Fatal("bulk DML did not finish after releasing the second flush")
+	}
+	for _, warning := range bulk.Session().GetSessionVars().StmtCtx.GetWarnings() {
+		require.NotContains(t, warning.Err.Error(), "Fallback to standard mode")
+	}
+	fresh.MustQuery("select id, u, pad from ai_conflict_dst order by id").
+		Check(testkit.Rows("1500 999999 online-winner"))
+	fresh.MustExec("admin check table ai_conflict_dst")
+}
