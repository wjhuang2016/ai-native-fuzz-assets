+func TestAINativePipelinedDMLMutationAlgebra(t *testing.T) {
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBMinFlushKeys", `return(50)`))
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBMinFlushSize", `return(1024)`))
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBForceFlushSizeThreshold", `return(32768)`))
+	defer func() {
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBMinFlushKeys"))
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBMinFlushSize"))
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBForceFlushSizeThreshold"))
+	}()
+
+	store := realtikvtest.CreateMockStoreAndSetup(t)
+	tk := testkit.NewTestKit(t, store)
+	fresh := testkit.NewTestKit(t, store)
+	tk.MustExec("use test")
+	fresh.MustExec("use test")
+	tk.MustQuery("select @@tidb_enable_metadata_lock").Check(testkit.Rows("1"))
+
+	createTable := func(name string) {
+		tk.MustExec(fmt.Sprintf(`create table %s(
+			id int primary key,
+			email int not null,
+			phone int not null,
+			payload int not null,
+			g int as (payload %% 97) stored,
+			unique key uk_email(email),
+			unique key uk_phone(phone),
+			key idx_g(g))`, name))
+	}
+	assertNoFallback := func() {
+		for _, warning := range tk.Session().GetSessionVars().StmtCtx.GetWarnings() {
+			require.NotContains(t, warning.Err.Error(), "Fallback to standard mode")
+		}
+	}
+	compareTables := func(standard, bulk string) {
+		stdRows := fresh.MustQuery(fmt.Sprintf("select id, email, phone, payload, g from %s order by id", standard)).Rows()
+		bulkRows := fresh.MustQuery(fmt.Sprintf("select id, email, phone, payload, g from %s order by id", bulk)).Rows()
+		require.Equal(t, stdRows, bulkRows)
+		fresh.MustExec("admin check table " + standard)
+		fresh.MustExec("admin check table " + bulk)
+	}
+	buildValues := func(prefix string, count int, row func(int) (int, int, int, int)) string {
+		buf := bytes.NewBuffer(make([]byte, 0, count*32))
+		buf.WriteString(prefix)
+		for i := range count {
+			if i > 0 {
+				buf.WriteString(",")
+			}
+			id, email, phone, payload := row(i)
+			_, _ = fmt.Fprintf(buf, "(%d,%d,%d,%d)", id, email, phone, payload)
+		}
+		return buf.String()
+	}
+
+	createTable("ai_replace_std")
+	createTable("ai_replace_bulk")
+	replaceRows := func(i int) (int, int, int, int) {
+		return i % 300, 1000 + (i*17+i/7)%350, 2000 + (i*29+i/11)%360, i
+	}
+	tk.MustExec("set session tidb_dml_type = standard")
+	tk.MustExec(buildValues("replace into ai_replace_std(id,email,phone,payload) values ", 1500, replaceRows))
+	tk.MustExec("set session tidb_dml_type = bulk")
+	tk.MustExec(buildValues("replace into ai_replace_bulk(id,email,phone,payload) values ", 1500, replaceRows))
+	assertNoFallback()
+	compareTables("ai_replace_std", "ai_replace_bulk")
+
+	createTable("ai_ondup_std")
+	createTable("ai_ondup_bulk")
+	onDupRows := func(i int) (int, int, int, int) {
+		id := i % 300
+		return id, 5000 + id, 6000 + id, i
+	}
+	tk.MustExec("set session tidb_dml_type = standard")
+	tk.MustExec(buildValues("insert into ai_ondup_std(id,email,phone,payload) values ", 1800, onDupRows) +
+		" on duplicate key update payload = values(payload)")
+	tk.MustExec("set session tidb_dml_type = bulk")
+	tk.MustExec(buildValues("insert into ai_ondup_bulk(id,email,phone,payload) values ", 1800, onDupRows) +
+		" on duplicate key update payload = values(payload)")
+	assertNoFallback()
+	compareTables("ai_ondup_std", "ai_ondup_bulk")
+}
