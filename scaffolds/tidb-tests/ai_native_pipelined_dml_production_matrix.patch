+func TestAINativePipelinedDMLLateDataErrorAtomicity(t *testing.T) {
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBMinFlushKeys", `return(10)`))
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBMinFlushSize", `return(100)`))
+	require.NoError(t, failpoint.Enable("tikvclient/pipelinedMemDBForceFlushSizeThreshold", `return(10240)`))
+	defer func() {
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBMinFlushKeys"))
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBMinFlushSize"))
+		require.NoError(t, failpoint.Disable("tikvclient/pipelinedMemDBForceFlushSizeThreshold"))
+	}()
+
+	store := realtikvtest.CreateMockStoreAndSetup(t)
+	tk := testkit.NewTestKit(t, store)
+	fresh := testkit.NewTestKit(t, store)
+	tk.MustExec("use test")
+	fresh.MustExec("use test")
+	tk.MustQuery("select @@tidb_enable_metadata_lock").Check(testkit.Rows("1"))
+
+	tk.MustExec("drop table if exists ai_src, ai_check, ai_unique")
+	tk.MustExec("create table ai_src(id int primary key, v int)")
+	values := bytes.NewBuffer(make([]byte, 0, 32768))
+	values.WriteString("insert into ai_src values ")
+	for i := range 2000 {
+		if i > 0 {
+			values.WriteString(",")
+		}
+		_, _ = fmt.Fprintf(values, "(%d,%d)", i, i)
+	}
+	tk.MustExec(values.String())
+	tk.MustExec("set session tidb_dml_type = bulk")
+
+	// A late NOT NULL error must roll back generations already flushed to TiKV.
+	tk.MustExec("create table ai_check(id int primary key, v int not null, pad varchar(128))")
+	err := tk.ExecToErr("insert into ai_check select id, if(id = 1500, null, v), repeat('x', 96) from ai_src order by id")
+	require.ErrorContains(t, err, "Column 'v' cannot be null")
+	for _, warning := range tk.Session().GetSessionVars().StmtCtx.GetWarnings() {
+		require.NotContains(t, warning.Err.Error(), "Fallback to standard mode")
+	}
+	fresh.MustQuery("select count(*) from ai_check").Check(testkit.Rows("0"))
+	fresh.MustExec("admin check table ai_check")
+
+	// A late unique-key collision must also undo earlier row and index rewrites.
+	tk.MustExec("set session tidb_dml_type = standard")
+	tk.MustExec("create table ai_unique(id int primary key, u int, pad varchar(128), unique key uk_u(u))")
+	tk.MustExec("insert into ai_unique select id, id, repeat('y', 96) from ai_src")
+	tk.MustExec("set session tidb_dml_type = bulk")
+	err = tk.ExecToErr("update ai_unique set u = if(id = 1500, 1800, u + 10000), pad = repeat('z', 96) order by id")
+	require.ErrorContains(t, err, "Duplicate entry '1800'")
+	for _, warning := range tk.Session().GetSessionVars().StmtCtx.GetWarnings() {
+		require.NotContains(t, warning.Err.Error(), "Fallback to standard mode")
+	}
+	fresh.MustQuery("select id, u from ai_unique where id in (0, 1499, 1500, 1800) order by id").
+		Check(testkit.Rows("0 0", "1499 1499", "1500 1500", "1800 1800"))
+	fresh.MustQuery("select count(*), sum(u) from ai_unique").Check(testkit.Rows("2000 1999000"))
+	fresh.MustExec("admin check table ai_unique")
+}
