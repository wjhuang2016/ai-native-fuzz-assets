+// Restore replaces the current user variables with a previously cloned state.
+func (s *UserVars) Restore(snapshot *UserVars) {
+	cloned := snapshot.Clone().(*UserVars)
+	s.lock.Lock()
+	defer s.lock.Unlock()
+	s.values = cloned.values
+	s.types = cloned.types
+}
